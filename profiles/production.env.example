# production — template. Copy to profiles/production.env (gitignored) and fill in
# the REPLACE_ME values, then provision with:
#
#   cd <run-dir> && /path/to/repo/smp.sh setup --profile production
#
# Only keys that differ from the built-in defaults need to be listed
# (see profiles/local.env for the full schema). smp.sh refuses to start while
# any REPLACE_ME value remains.

# ---- secrets: use long random strings (e.g. `openssl rand -hex 32`)
SMP_FORWARDING_SECRET=REPLACE_ME
SMP_SHARED_SECRET=REPLACE_ME

# ---- DataGSM OAuth: real credentials issued for this server.
# The registered redirect URI must be ${SMP_PUBLIC_BASE_URL}/callback.
SMP_DATAGSM_CLIENT_ID=REPLACE_ME
SMP_DATAGSM_CLIENT_SECRET=REPLACE_ME
SMP_DATAGSM_SCOPE=datagsm:self_read

# ---- the externally reachable URL of the auth web server (players open this)
SMP_PUBLIC_BASE_URL=REPLACE_ME_e.g._https://smp.example.kr

# ---- JVM (Linux): the macOS/brew default path won't exist here, so point this
# at your Java 25 binary — it drives both the build and the running servers.
# Find it with:  readlink -f $(which java)
SMP_JAVA=/usr/lib/jvm/java-25-openjdk/bin/java

# ---- real Mojang authentication in production
SMP_ONLINE_MODE=true
SMP_MOTD="<aqua>SMP Network"
SMP_MAX_PLAYERS=50
SMP_LEVEL_TYPE='minecraft\:normal'
