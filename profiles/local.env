# local — out-of-the-box test profile (offline mode, placeholder credentials).
# Every key smp.sh understands is spelled out here; this file doubles as the
# schema reference. A profile only needs the keys it overrides — smp.sh has
# built-in defaults identical to these values.
#
# Rendered configs are regenerated from this file on every `smp.sh start` —
# edit here, never the generated config.properties/velocity.toml files.

# ---- ports
SMP_VELOCITY_PORT=25565   # players connect here
SMP_LOBBY_PORT=25566      # Minestom lobby (Velocity server "lobby")
SMP_PAPER_PORT=25567      # Paper content server (Velocity server "content")
SMP_AUTH_PORT=8080        # auth web server

# ---- secrets
SMP_FORWARDING_SECRET=smp-test-forwarding-secret   # Velocity <-> lobby/paper modern forwarding
SMP_SHARED_SECRET=smp-test-shared-secret           # auth-server <-> lobby <-> velocity plugin REST

# ---- DataGSM OAuth (test placeholders; real login needs production credentials)
SMP_DATAGSM_CLIENT_ID=test-client-id
SMP_DATAGSM_CLIENT_SECRET=test-client-secret
SMP_DATAGSM_SCOPE=self:read
SMP_PUBLIC_BASE_URL=      # empty => http://127.0.0.1:${SMP_AUTH_PORT}

# ---- velocity-plugin gating
SMP_GATED_SERVERS=        # comma-separated server names; empty = every non-lobby server is gated
SMP_CONTENT_SERVER_NAME=content

# ---- network behavior
SMP_ONLINE_MODE=false     # offline so you can join locally without a premium account
SMP_MOTD="<aqua>SMP Test Network"
SMP_MAX_PLAYERS=20
SMP_LEVEL_TYPE='minecraft\:flat'

# ---- runtime / versions
SMP_JAVA=                 # empty => brew openjdk@25 if present, else "java" on PATH.
                          # On Linux the brew path won't exist, so set an explicit
                          # Java 25 binary here (drives both build and runtime),
                          # e.g. SMP_JAVA=/usr/lib/jvm/java-25-openjdk/bin/java
SMP_PAPER_VERSION=26.2
SMP_VELOCITY_VERSION=3.5.0-SNAPSHOT
SMP_PAPER_HEAP="-Xms1G -Xmx2G"
SMP_VELOCITY_HEAP="-Xms256M -Xmx512M -XX:+UseG1GC"
